{
  "name": "my-personal-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:content": "node scripts/import-content.mjs",
    "add:quotes": "node scripts/add-quotes.mjs",
    "add:books": "node scripts/add-likes.mjs books",
    "add:movies": "node scripts/add-likes.mjs movies",
    "add:videos": "node scripts/add-likes.mjs videos",
    "add:articles": "node scripts/add-likes.mjs articles",
    "add:other": "node scripts/add-likes.mjs other",
    "fetch:spotify": "node scripts/fetch-spotify-meta.mjs",
    "fetch:movie-wiki": "node scripts/fetch-movie-wiki.mjs",
    "fetch:book-links": "node scripts/fetch-book-links.mjs",
    "pin:quotes": "node scripts/pin-quotes.mjs",
    "pin:books": "node scripts/pin-likes.mjs books",
    "pin:movies": "node scripts/pin-likes.mjs movies",
    "pin:videos": "node scripts/pin-likes.mjs videos",
    "pin:articles": "node scripts/pin-likes.mjs articles",
    "pin:other": "node scripts/pin-likes.mjs other",
